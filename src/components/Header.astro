<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-name">C.K.</a>

    <nav id="site-navigation" aria-label="Main navigation" hidden>
      <ul class="nav-list">
        <li><a href="#about">About</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#writing">Writing</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-menu-toggle
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="2" y="2" width="11" height="11" fill="currentColor" />
        <rect x="2" y="19" width="11" height="11" fill="currentColor" />
        <rect x="19" y="19" width="11" height="11" fill="currentColor" />
        <rect x="19" y="6.5" width="11" height="3" fill="currentColor" />
        <rect
          class="menu-toggle-vertical"
          x="23"
          y="2.5"
          width="3"
          height="11"
          fill="currentColor"
        />
      </svg>
    </button>
  </div>
</header>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const navigation = document.querySelector<HTMLElement>("#site-navigation");

  if (menuToggle && navigation) {
    const header = menuToggle.closest<HTMLElement>(".site-header");
    let closeTimeout: number | undefined;

    const main = document.querySelector("main");
    const footer = document.querySelector("footer");

    const setBackgroundInert = (inert: boolean) => {
      if (main) main.inert = inert;
      if (footer) footer.inert = inert;
    };

    const closeMenu = (restoreFocus = false) => {
      if (closeTimeout !== undefined) window.clearTimeout(closeTimeout);
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.setAttribute("aria-label", "Open navigation menu");
      header?.classList.remove("is-open");
      document.body.classList.remove("menu-open");
      setBackgroundInert(false);

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        navigation.hidden = true;
      } else {
        closeTimeout = window.setTimeout(() => {
          if (menuToggle.getAttribute("aria-expanded") === "false") {
            navigation.hidden = true;
          }
        }, 240);
      }

      if (restoreFocus) menuToggle.focus({ preventScroll: true });
    };

    navigation.addEventListener("transitionend", (event) => {
      if (
        event.target === navigation &&
        (event.propertyName === "clip-path" || event.propertyName === "max-height") &&
        menuToggle.getAttribute("aria-expanded") === "false"
      ) {
        if (closeTimeout !== undefined) window.clearTimeout(closeTimeout);
        navigation.hidden = true;
      }
    });

    menuToggle.addEventListener("click", () => {
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      if (closeTimeout !== undefined) window.clearTimeout(closeTimeout);

      if (isOpen) {
        closeMenu();
        return;
      }

      navigation.hidden = false;
      void navigation.offsetWidth;
      menuToggle.setAttribute("aria-expanded", "true");
      menuToggle.setAttribute("aria-label", "Close navigation menu");
      header?.classList.add("is-open");
      document.body.classList.add("menu-open");
      setBackgroundInert(true);
      navigation.querySelector<HTMLAnchorElement>("a")?.focus();
    });

    navigation.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        closeMenu();
        window.setTimeout(() => menuToggle.focus({ preventScroll: true }), 0);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menuToggle.getAttribute("aria-expanded") === "true") {
        closeMenu(true);
      }
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 10;
    top: var(--space-2xl);
    left: 50%;
    width: min(calc(100% - (var(--page-padding) * 2)), var(--container-width));
    height: var(--space-2xl);
    transform: translateX(-50%);
    border: 1px solid var(--color-muted);
    border-radius: 0.75rem;
    background: rgb(22 37 33 / 94%);
  }

  @media (min-width: 640px) {
  .site-header {
    width: min(calc(100% - 9rem), 50rem);
  }
}

  .header-inner {
    display: flex;
    height: 100%;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--space-sm);
    gap: var(--space-lg);
  }

  .site-name {
    flex: 0 0 auto;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
  }

  .site-name:focus-visible,
  .menu-toggle:focus-visible,
  nav a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .menu-toggle {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    align-content: center;
    justify-items: center;
    padding: var(--space-xs);
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--color-text);
  }

  .menu-toggle svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .menu-toggle-vertical {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      transform 160ms ease,
      opacity 160ms ease;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle-vertical {
    transform: scaleY(0);
    opacity: 0;
  }

  nav {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    justify-content: flex-end;
    margin-left: auto;
    overflow: hidden;
    clip-path: inset(0 0 0 100%);
    opacity: 0;
    transition:
      clip-path 220ms ease,
      opacity 160ms ease;
  }

  .site-header.is-open nav {
    clip-path: inset(0);
    opacity: 1;
  }

  nav[hidden] {
    display: none;
  }

  .nav-list {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    padding-block: var(--space-sm);
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  nav a:hover,
  nav a:active {
    color: var(--color-text);
  }

  :global(body.menu-open) {
      overflow: hidden;
    }

  @media (max-width: 640px) {
    .header-inner {
      gap: var(--space-xs);
    }

    .site-name {
      font-size: 1.25rem;
    }

    .menu-toggle {
      width: 2.5rem;
      height: 2.5rem;
    }

    .site-header.is-open {
      border-bottom-color: transparent;
      border-radius: 0.75rem 0.75rem 0 0;
    }

    nav {
      position: absolute;
      inset: 100% 0 auto;
      display: block;
      width: 100%;
      max-height: 0;
      padding-inline: max(var(--page-padding), calc((100% - var(--container-width)) / 2));
      border: 1px solid var(--color-muted);
      border-top: 0;
      border-radius: 0 0 0.75rem 0.75rem;
      background: rgb(22 37 33 / 94%);
      clip-path: none;
      opacity: 0;
      transition:
        max-height 220ms ease,
        opacity 160ms ease;
    }

    .site-header.is-open nav {
      max-height: 20rem;
      opacity: 1;
    }

    :global(body.menu-open::before) {
      position: fixed;
      z-index: 9;
      inset: 0;
      background: transparent;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      content: "";
      pointer-events: none;
    }


    .nav-list {
      display: grid;
      width: 100%;
      gap: var(--space-xs);
      padding-block: var(--space-xs);
    }

    nav a {
      padding-block: var(--space-xs);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle-vertical,
    nav,
    nav a {
      transition: none;
    }
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header,
    nav {
      border-color: color-mix(in srgb, var(--color-muted) 45%, transparent);
      background: color-mix(in srgb, var(--color-background) 78%, transparent);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
    }
  }
</style>
