---
interface Props {
  href?: string;
  type?: "button" | "submit";
}

const { href, type = "button" } = Astro.props;
---

{
  href ? (
    <a class="button" href={href}>
      <slot />
    </a>
  ) : (
    <button class="button" type={type}>
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-accent);
    border-radius: 8px;
    background: var(--color-accent);
    color: var(--color-text);
    font: inherit;
    font-size: 1.2rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      transform 180ms ease;
  }

  .button:hover {
    background: #e45011;
    transform: translate(2px, -2px) scale(1.02);
  }

  .button:active {
    transform: translate(0, 0) scale(0.99);
  }

  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }

    .button:hover,
    .button:active {
      transform: none;
    }
  }
</style>