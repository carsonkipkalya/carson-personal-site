---
interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<div class="section-heading">
  <p class="section-label">{label}</p>
  <h2>{title}</h2>
</div>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-xs);
  }

  .section-label {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  h2 {
    font-size: clamp(1.75rem, 3vw, 2.8rem);
    font-weight: 600;
  }
</style>