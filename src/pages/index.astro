---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section id="hero" class="container hero" aria-label="Hero">
    <h1>Carson Kipkalya</h1>
  </section>

  <section id="about" class="container" aria-label="About and direction"></section>
  <section id="projects" class="container" aria-label="Selected projects"></section>
  <section id="services" class="container" aria-label="Services"></section>
  <section id="writing" class="container" aria-label="Writing and notes"></section>
  <section id="contact" class="container" aria-label="Contact and socials"></section>
</BaseLayout>

<style>
  .hero {
    min-height: 60vh;
    display: grid;
    align-items: center;
  }

  h1 {
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 700;
  }
</style>