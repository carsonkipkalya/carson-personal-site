---
import { getCollection, render } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import ExpandablePost from "../components/ExpandablePost.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { socials } from "../data/socials";

const projects = await getCollection("projects");
const writingEntries = await getCollection("writing");
const renderWritingEntries = async (entries: typeof writingEntries) =>
  Promise.all(entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })));
const writingNotes = await renderWritingEntries(
  writingEntries.filter((entry) => entry.data.type === "note"),
);
const writingCreativeWorks = await renderWritingEntries(
  writingEntries.filter((entry) => entry.data.type !== "note"),
);
const hasBothWritingGroups = writingNotes.length > 0 && writingCreativeWorks.length > 0;
const [github, x, substack] = socials;
---

<BaseLayout>
  <section id="hero" class="container hero" aria-labelledby="hero-title">
    <div class="hero-content">
      <h1 id="hero-title">
        Carson Kipkalya
      </h1>
      <p class="hero-supporting">
        I study systems, build software, and spend a lot of my time reading about philosophy, and fiction. <br>Right now, most of what I build is practical — software projects, and websites for small businesses and startups.
      </p>
      <div class="hero-actions">
  <Button href="#projects">View my work</Button>

  <ul class="hero-socials" aria-label="External links">
    <li>
    <a
      href={github.href}
      class="hero-social-link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={github.ariaLabel}
    >
      <svg
        class="hero-social-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16 16"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59c.4.07.55-.17.55-.38c0-.19-.01-.82-.01-1.49c-2.01.37-2.53-.49-2.69-.94c-.09-.23-.48-.94-.82-1.13c-.28-.15-.68-.52-.01-.53c.63-.01 1.08.58 1.23.82c.72 1.21 1.87.87 2.33.66c.07-.52.28-.87.51-1.07c-1.78-.2-3.64-.89-3.64-3.95c0-.87.31-1.59.82-2.15c-.08-.2-.36-1.02.08-2.12c0 0 .67-.21 2.2.82c.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82c.44 1.1.16 1.92.08 2.12c.51.56.82 1.27.82 2.15c0 3.07-1.87 3.75-3.65 3.95c.29.25.54.73.54 1.48c0 1.07-.01 1.93-.01 2.2c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
        />
      </svg>
      <span class="hero-social-label">{github.description}</span>
    </a>
    </li>

    <li>
    <a
      href={x.href}
      class="hero-social-link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={x.ariaLabel}
    >
      <svg
        class="hero-social-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16 16"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07l-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"
        />
      </svg>
      <span class="hero-social-label">{x.description}</span>
    </a>
    </li>

    <li>
    <a
      href={substack.href}
      class="hero-social-link"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={substack.ariaLabel}
    >
      <svg
        class="hero-social-icon"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16 16"
        aria-hidden="true"
        focusable="false"
      >
        <path
          fill="currentColor"
          d="M15 3.604H1v1.891h14v-1.89ZM1 7.208V16l7-3.926L15 16V7.208zM15 0H1v1.89h14z"
        />
      </svg>
      <span class="hero-social-label">{substack.description}</span>
    </a>
    </li>
  </ul>
</div>
    </div>
  </section>

  <section id="about" class="container about" aria-label="About and direction">
    <SectionHeading
      label="About"
      title="A Little Context"
    />

  
    <div class="about-content">
      <p>I'm interested in how things work: I build software, client websites, and small experiments. Outside of code, I read a lot of fiction and philosophy, and I'm curious about design, storytelling, and human behavior. </p>
      <p>I learn by moving between theory and practice. Some of my work is practical. Some of it is exploratory. Some of it is just me trying to understand something better.</p>
      <p>Right now I'm focused on getting better at building useful things and communicating them clearly. I expect that focus to evolve as I find better questions to work on.</p>
    </div>
  </section>
  <section id="projects" class="container" aria-label="Selected projects">
    <SectionHeading label="Projects" title="Selected Work" />

    <div class="projects-list">
      {projects
        .filter((project) => project.data.featured)
        .map((project) => (
          <ProjectCard
            id={project.id}
            title={project.data.title}
            description={project.data.description}
            tags={project.data.tags}
            stack={project.data.stack}
            artifact={project.data.artifact}
            problem={project.data.problem}
            approach={project.data.approach}
            outcome={project.data.outcome}
            links={project.data.links}
          />
        ))}
    </div>
  </section>
  <section id="services" class="container services" aria-label="Services">
    <SectionHeading
      label="Services"
      title="Websites and Landing Pages"
    />
    <div class="services-content">
      <p>I build websites and landing pages for small businesses and startups.
          A good site should make it obvious what you offer, who it's for, and what a visitor should do next — that's what I focus on.
      </p>
      <p>
          If you have something you're trying to communicate, I can help turn it into a site that does that.
      </p>
      <ul role="list">
        <li>Website and landing-page design</li>
        <li>Responsive front-end development</li>
        <li>Structuring and presenting your content</li>
        <li>Turning an existing idea into a clear web presence</li>
      </ul>

      <div class="services-actions">
          <Button href="mailto:hello.carsonkipkalya@gmail.com">Work with me</Button>
        </div>
    </div>
  </section>
  <section id="writing" class="container writing" aria-label="Writing and notes">
    <SectionHeading label="Writing" title="Notes and Creative Work" />

    <div class:list={["writing-groups", { "writing-groups--two": hasBothWritingGroups }]}>
      {writingNotes.length > 0 && (
        <section class="writing-group" aria-labelledby="writing-notes-title">
          <h3 id="writing-notes-title">Notes</h3>
          <div class="writing-group-list">
            {writingNotes.map(({ entry, Content }) => (
              <ExpandablePost
                id={entry.id}
                title={entry.data.title}
                description={entry.data.description}
                contentType={entry.data.type}
                publishedOn={entry.data.publishedOn}
                publishedDate={entry.data.publishedDate}
                externalUrl={entry.data.externalUrl}
              >
                <Content />
              </ExpandablePost>
            ))}
          </div>
        </section>
      )}
      {writingCreativeWorks.length > 0 && (
        <section class="writing-group" aria-labelledby="writing-creative-title">
          <h3 id="writing-creative-title">Creative Work</h3>
          <div class="writing-group-list">
            {writingCreativeWorks.map(({ entry, Content }) => (
              <ExpandablePost
                id={entry.id}
                title={entry.data.title}
                description={entry.data.description}
                contentType={entry.data.type}
                publishedOn={entry.data.publishedOn}
                publishedDate={entry.data.publishedDate}
                externalUrl={entry.data.externalUrl}
              >
                <Content />
              </ExpandablePost>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
  <section id="contact" class="container contact" aria-label="Contact and socials">
    <SectionHeading
      label="Contact"
      title="Let's Work Together"
    />
    <div class="contact-content">
      <div class="contact-primary">
        <p>Interested in working together, talking about a project, or just comparing notes? Send me a message.</p>
        <div class="contact-actions">
          <Button href="mailto:hello.carsonkipkalya@gmail.com">Get in touch</Button>
        </div>
      </div>
      <ul class="contact-links">
        <li>
          <a class="contact-card" href={github.href} target="_blank"
  rel="noopener noreferrer">
            <svg
              class="hero-social-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59c.4.07.55-.17.55-.38c0-.19-.01-.82-.01-1.49c-2.01.37-2.53-.49-2.69-.94c-.09-.23-.48-.94-.82-1.13c-.28-.15-.68-.52-.01-.53c.63-.01 1.08.58 1.23.82c.72 1.21 1.87.87 2.33.66c.07-.52.28-.87.51-1.07c-1.78-.2-3.64-.89-3.64-3.95c0-.87.31-1.59.82-2.15c-.08-.2-.36-1.02.08-2.12c0 0 .67-.21 2.2.82c.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82c.44 1.1.16 1.92.08 2.12c.51.56.82 1.27.82 2.15c0 3.07-1.87 3.75-3.65 3.95c.29.25.54.73.54 1.48c0 1.07-.01 1.93-.01 2.2c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"
              />
            </svg>
            <span class="contact-card-copy">
              <span class="contact-card-name">Github</span>
              <span class="contact-card-description">Software projects</span>
            </span>
            <svg class="contact-card-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 12" aria-hidden="true" focusable="false">
              <path d="M2 6h11M9 2l4 4-4 4" />
            </svg>
          </a>
        </li>
        <li>
          <a class="contact-card" href={x.href} target="_blank"
      rel="noopener noreferrer">
            <svg
              class="hero-social-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill="currentColor"
                d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07l-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865z"
              />
            </svg>
            <span class="contact-card-copy">
              <span class="contact-card-name">X</span>
              <span class="contact-card-description">Short-form thoughts</span>
            </span>
            <svg class="contact-card-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 12" aria-hidden="true" focusable="false">
              <path d="M2 6h11M9 2l4 4-4 4" />
            </svg>
          </a>
        </li>
        <li>
          <a class="contact-card" href={substack.href} target="_blank"
      rel="noopener noreferrer">
            <svg
              class="hero-social-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              aria-hidden="true"
              focusable="false"
            >
              <path
                fill="currentColor"
                d="M15 3.604H1v1.891h14v-1.89ZM1 7.208V16l7-3.926L15 16V7.208zM15 0H1v1.89h14z"
              />
            </svg>
            <span class="contact-card-copy">
              <span class="contact-card-name">Substack</span>
              <span class="contact-card-description">Long-form writing</span>
            </span>
            <svg class="contact-card-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 12" aria-hidden="true" focusable="false">
              <path d="M2 6h11M9 2l4 4-4 4" />
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    align-items: center;
    padding-block: var(--space-2xl);
  }

  .hero-content {
    display: grid;
    justify-items: center;
    gap: 0;
    max-width: 60rem;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
  .hero-content {
    justify-items: start;
    margin-inline: 0;
  }
}


  h1 {
    max-width: 20ch;
    margin-top: var(--space-md);
    font-size: clamp(2.375rem, 6vw, 6rem);
    font-weight: 700;
    text-wrap: balance;
  }

  .hero-supporting {
    max-width: 50ch;
    margin-top: var(--space-lg);
    
  }

  @media (min-width: 640px) {
  .hero-supporting {
    max-width: clamp(26rem, 50vw, 32rem);
  }
}

@media (min-width: 1100px) {
  .hero-supporting {
    max-width: 45ch;
  }
}


  .hero-actions {
  display: flex;
  align-items: center;
  gap: var(--space-xl);
  margin-top: var(--space-lg);
}

@media (min-width: 1100px) {
  .hero-actions {
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
  }
}

.hero-socials {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin: 0;
  padding: 0;
  list-style: none;
}

.hero-socials li {
  display: flex;
}

.hero-social-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  color: var(--color-text);
  text-decoration: none;
}

.hero-social-icon {
  width: 1.5rem;
  height: 1.5rem;
  display: block;
  transition: transform 160ms ease;
}

.hero-social-link:hover .hero-social-icon {
  transform: translateY(-2px);
}

.hero-social-link:focus-visible {
  outline: 2px solid var(--color-text);
  outline-offset: 4px;
}

.hero-social-label {
  position: absolute;
  left: 50%;
  top: calc(100% + var(--space-sm));
  width: max-content;
  max-width: 12rem;
  transform: translateX(-50%) translateY(-4px);
  color: var(--color-muted);
  font-size: 0.875rem;
  opacity: 0;
  pointer-events: none;
  transition:
    opacity 160ms ease,
    transform 160ms ease;
}

.hero-social-link:hover .hero-social-label,
.hero-social-link:focus-visible .hero-social-label {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

  .about-content {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
    max-width: 70ch;
  }


  @media (min-width: 640px) {
    .about-content{
      max-width: 55ch;
    }
  }


  .projects-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3xl);
    margin-top: var(--space-2xl);
  }

  @media (min-width: 640px) {
  .projects-list {
    grid-template-columns: repeat(2, minmax(0, 30rem));
    justify-content: center;
    gap:var(--space-xl);
  }
}

  .services-content {
    display: grid;
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  .services-actions {
  justify-self: center;
  }


  .services-content ul {
  display: grid;
  gap: var(--space-md);
  margin: 0;
  padding: var(--space-lg);
  border: 1px solid color-mix(
    in srgb,
    var(--color-muted) 35%,
    var(--color-background)
  );
  border-radius: 0.75rem;
  background: color-mix(
    in srgb,
    var(--color-text) 4%,
    var(--color-background)
  );
  list-style: none;
}

.services-content li {
  position: relative;
  padding-left: 1.75rem;
  color: var(--color-text);
  font-weight: 500;
}

.services-content li::before {
  position: absolute;
  top: 0.55em;
  left: 0;
  width: 0.45rem;
  height: 0.45rem;
  background: var(--color-muted);
  content: "";
}

@media (min-width: 640px) {
  .services-content {
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.75fr);
    align-items: center;
    column-gap: var(--space-3xl);
  }

  .services-content p {
    grid-column: 1;
    max-width: 50ch;
  }

  .services-content ul {
    grid-column: 2;
    grid-row: 1 / span 3;
  }

  .services-actions {
    grid-column: 1;
    grid-row: 3;
    justify-self: start;
  }
}

  .writing-groups {
    display: grid;
    gap: var(--space-2xl);
  }

  .writing-group {
    display: grid;
    align-content: start;
    gap: var(--space-lg);
  }

  .writing-group h3 {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 500;
  }

  .writing-group-list {
    display: grid;
    align-content: start;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .writing-groups--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .contact-content {
    display: grid;
    gap: var(--space-2xl);
    margin-top: var(--space-2xl);
  }

  @media (min-width: 640px) {
    .contact-content {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
      align-items: center;
      gap: var(--space-2xl);
    }
  }

  .contact-primary {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-lg);
  }

  .contact-primary p {
    max-width: 65ch;
  }

  .contact-links {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-card {
    display: flex;
    align-items: center;
    margin-inline: auto;
    gap: var(--space-md);
    max-width: 30rem;
    padding: var(--space-md);
    border: 1px solid color-mix(in srgb, var(--color-muted) 38%, var(--color-background));
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-text) 4%, var(--color-background));
    color: var(--color-text);
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .contact-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-muted);
    box-shadow: 0 0 16px rgb(229 244 227 / 15%);
  }

  .contact-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .contact-card .hero-social-icon {
    flex: 0 0 auto;
  }

  .contact-card-arrow {
    flex: 0 0 auto;
    width: 1rem;
    height: 0.7rem;
    margin-left: auto;
    overflow: visible;
    fill: none;
    stroke: var(--color-muted);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1;
    transition: transform 180ms ease;
  }

  .contact-card:hover .contact-card-arrow {
    transform: translateX(2px);
  }

  .contact-card-copy {
    display: grid;
    gap: var(--space-xs);
    overflow-wrap: anywhere;
  }

  .contact-card-name {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .contact-card-description {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-social-icon,
    .hero-social-label,
    .contact-card,
    .contact-card-arrow {
      transition: none;
    }

    .hero-social-link:hover .hero-social-icon,
    .contact-card:hover,
    .contact-card:hover .contact-card-arrow {
      transform: none;
    }
  }

</style>